@startuml zipper9_usecase
!theme plain
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Malgun Gothic"

title zipper9 유스케이스 다이어그램 (Use Case Diagram)

left to right direction

actor "사용자\n(User)" as User
actor "운영체제 파일 시스템\n(OS File System)" as OS
actor "Native Engine\n(7z / lz4 / zstd)" as NativeEngine

rectangle "zipper9 압축/해제 시스템" {
    package "압축 관리 (Compression)" {
        usecase "UC01: 파일 및 폴더 선택\n(탐색기 대화상자 / 드래그 앤 드롭)" as UC_AddFiles
        usecase "UC02: 압축 대상 목록 관리\n(개별 항목 [✕] 삭제 / 전체 비우기)" as UC_ManageList
        usecase "UC03: 고성능 압축 알고리즘 선택\n(ZIP / 7z / LZ4 / Zstd / TAR)" as UC_SelectAlgo
        usecase "UC04: 아카이브 압축 실행\n(분할 압축 및 암호화 포함)" as UC_Compress
    }

    package "해제 및 분석 (Extraction & Inspection)" {
        usecase "UC05: 아카이브 열기\n(ZIP, 7z, RAR, Apple DMG/PKG, TAR, LZ4)" as UC_OpenZip
        usecase "UC06: 아카이브 내부 파일 미리보기\n및 압축률(절감률) 통계 확인" as UC_Inspect
        usecase "UC07: 대상 폴더에 압축 해제 실행\n(덮어쓰기 정책 및 스마트 단일폴더 감지)" as UC_Extract
    }

    package "편의 및 시스템 설정 (System & Convenience)" {
        usecase "UC08: 실시간 진행률/속도/경과시간 모니터링" as UC_Progress
        usecase "UC09: 다크/라이트 모드 테마 전환" as UC_Theme
        usecase "UC10: 한국어 / English 다국어 실시간 전환" as UC_I18n
        usecase "UC11: 탐색기 우클릭 메뉴 연동\n(Windows 10 클래식 및 Win11 모던 1단계)" as UC_ContextMenu
        usecase "UC12: 파일 확장자 기본 연결" as UC_FileAssoc
    }
}

' User relationships
User --> UC_AddFiles
User --> UC_ManageList
User --> UC_SelectAlgo
User --> UC_Compress
User --> UC_OpenZip
User --> UC_Inspect
User --> UC_Extract
User --> UC_Theme
User --> UC_I18n
User --> UC_ContextMenu
User --> UC_FileAssoc

' Includes & Extends
UC_Compress ..> UC_Progress : <<include>>
UC_Extract ..> UC_Progress : <<include>>
UC_OpenZip ..> UC_Inspect : <<include>>

' System Actor relationships
UC_AddFiles --> OS : 파일/디렉터리 읽기
UC_Compress --> OS : 아카이브 파일 생성 쓰기
UC_Compress --> NativeEngine : 멀티코어 고속 압축 실행
UC_Extract --> OS : 대상 디렉터리 파일 복원
UC_Extract --> NativeEngine : 멀티코어 고속 해제 실행
UC_Inspect --> NativeEngine : 아카이브 헤더 정보 질의

@enduml
