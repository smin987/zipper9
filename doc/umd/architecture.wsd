@startuml zipper9_architecture
!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle uml2
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "Malgun Gothic"

title zipper9 시스템 컴포넌트 아키텍처 (Component Architecture)

package "UI Layer (Python / CustomTkinter)" {
    [Zipper9App] as App <<GUI Application>>
    [ThemeManager] as Theme
    [i18n Module] as I18n
    [Settings Module] as Settings
    
    note right of App
        - 다크/라이트 모드 지원
        - 파일/폴더 선택 및 드래그 앤 드롭
        - 실시간 프로그레스 바 & 속도/ETA
        - ZIP/7Z/TAR 내부 파일 목록 미리보기
        - 다국어 (한국어 / English) 실시간 전환
    end note
}

package "Bridge Layer (Python)" {
    [CompressionWorker] as Worker <<Multi-Core Engine Controller>>
    [ContextMenuManager] as ContextMenu <<Classic / Modern Windows 11>>
    [FileAssociationManager] as FileAssoc <<Default App Registry>>
    [InstantOps] as Instant <<Zero-GUI Fast Compress / Extract>>
    
    note bottom of Worker
        - 백그라운드 스레드 분리 (UI 프리징 방지)
        - 다중 네이티브 엔진 제어 (Subprocess IPC):
          * ZIP: 7z.exe (Deflate / Zstd)
          * 7z: 7z.exe (LZMA2 Ultra 멀티코어)
          * LZ4: lz4.exe (초고속 스트리밍 압축)
          * Zstd: zstd.exe (멀티스레드 초고속 압축)
          * TAR: Python tarfile (gz/xz/bz2)
          * RAR: 7z.exe UnRAR Engine (RAR4/RAR5 해제)
          * Apple: 7z.exe DMG/PKG/XAR Engine 해제
    end note
}

package "Windows 11 Modern Shell (Rust COM)" #E8F4F8 {
    [zipper9_shell.dll] as ShellDll <<IExplorerCommand / COM In-Proc Server>>
    [MSIX Sparse Package] as ShellPackage <<Windows 11 1-Click Context Menu>>
}

package "Native Engine Layer (100% C/C++)" #FDF6E2 {
    [7-Zip Engine (7z.exe / 7z.dll)] as SevenZEngine <<LGPL Multi-Core C++>>
    [LZ4 Engine (lz4.exe)] as LZ4Engine <<Official C CLI>>
    [Zstandard Engine (zstd.exe)] as ZstdEngine <<Official Multi-Threaded C/C++>>
}

database "File System" {
    [Source Files / Folders] as SrcFiles
    [Target Archives (.zip, .7z, .tar, .lz4, .zst)] as Archives
    [Extracted Output Dir] as OutDir
}

' Relations - UI to Bridge
App --> Worker : 1. 비동기 작업 요청 (compress / extract)
App --> ContextMenu : 우클릭 메뉴 등록/해제
App --> FileAssoc : 파일 확장자 연결
App ..> Theme : 테마 전환
App ..> I18n : 다국어 번역 문자열 조회
App ..> Settings : 사용자 설정 로드/저장

' Relations - Windows Shell
ContextMenu --> ShellPackage : MSIX 패키지 등록/해제
ShellPackage ..> ShellDll : COM In-Proc 로드
ShellDll --> App : 바로가기 명령 실행 (--compress / --extract)
ShellDll --> Instant : 즉시 압축 / 즉시 해제 호출

' Relations - Worker to Native Engines
Worker --> SevenZEngine : IPC 호출 (-mmt=on 멀티스레드)
Worker --> LZ4Engine : IPC 호출 (초고속 스트림)
Worker --> ZstdEngine : IPC 호출 (-T0 멀티코어)

' Relations - File System
SevenZEngine --> SrcFiles : Read
SevenZEngine --> Archives : Write
SevenZEngine --> OutDir : Extract

LZ4Engine --> SrcFiles : Read
LZ4Engine --> Archives : Write
LZ4Engine --> OutDir : Extract

ZstdEngine --> SrcFiles : Read
ZstdEngine --> Archives : Write
ZstdEngine --> OutDir : Extract

@enduml
